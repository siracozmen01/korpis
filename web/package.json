{
  "name": "@korpis/web",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.sw.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "generate": "../.tools/bin/buf generate --template buf.gen.yaml",
    "extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"src/gen/**\" --ignore \"src/**/*.test.{ts,tsx}\" --additional-function-names t --id-interpolation-pattern \"[sha512:contenthash:base64:8]\" --throws --out-file src/i18n/en.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-intl": "12.1.3",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@eslint/js": "10.0.1",
    "@formatjs/cli": "6.16.32",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-formatjs": "8.1.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
