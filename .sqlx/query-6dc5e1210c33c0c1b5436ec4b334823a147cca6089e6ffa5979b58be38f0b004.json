  "query": "SELECT id, organization_id, name, verification, token, parent_id, verified_at,\n                    created_at\n               FROM domain\n              WHERE verified_at IS NOT NULL\n                AND (name = $1\n                     OR right($1, length(name) + 1) = '.' || name\n                     OR right(name, length($1) + 1) = '.' || $1)\n              ORDER BY id",
