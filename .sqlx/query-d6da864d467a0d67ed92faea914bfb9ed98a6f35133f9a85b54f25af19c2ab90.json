  "db_name": "PostgreSQL",
  "query": "SELECT id, project_id, created_by, attached_to, name, kind, node_id, helper_id,\n                    storage_class, size_bytes, quota_enforced, created_at, detached_at, deleted_at\n               FROM volume\n              WHERE project_id = $1\n                AND ($2::uuid IS NULL OR created_by = $2 OR attached_to = $2)\n                AND ($3 OR deleted_at IS NULL)\n                AND ($4::uuid IS NULL OR id > $4)\n              ORDER BY id LIMIT $5",
