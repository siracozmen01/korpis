  "query": "SELECT v.name, v.helper_id FROM volume v\n              WHERE v.attached_to = $1 AND v.deleted_at IS NULL AND v.kind = 'declared'\n                AND EXISTS (SELECT 1 FROM volume d WHERE d.divergent_of = v.id)\n              ORDER BY v.name",
