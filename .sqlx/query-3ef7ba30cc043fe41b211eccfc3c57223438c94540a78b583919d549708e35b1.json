{
  "db_name": "PostgreSQL",
  "query": "SELECT id, project_id, organization_id, name, labels, intent_id, intent_version,\n                    target_id, target_version, power_version, power_target_version, version,\n                    created, deleted_at, set_id, classification, unreproducible_at,\n                    unreproducible_reason\n               FROM workload\n              WHERE deleted_at IS NULL\n                AND ($1::uuid IS NULL OR project_id = $1)\n                AND ($2::uuid IS NULL OR organization_id = $2)\n                AND ($3::uuid IS NULL OR id > $3)\n                AND ($5::uuid IS NULL OR set_id = $5)\n                AND ($6::uuid IS NULL OR organization_id IN (\n                    WITH RECURSIVE tree AS (\n                        SELECT $6::uuid AS id\n                        UNION\n                        SELECT o.id FROM organization o JOIN tree ON o.parent_id = tree.id\n                    )\n                    SELECT id FROM tree))\n              ORDER BY id LIMIT $4",
