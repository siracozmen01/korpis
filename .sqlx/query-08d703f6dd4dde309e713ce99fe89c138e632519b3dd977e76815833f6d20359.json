  "query": "SELECT k.id, k.account_id, k.kind, k.public_key, k.label, k.within_id, k.added_at,\n                    k.last_used_at\n               FROM ssh_key k JOIN account a ON a.id = k.account_id\n              WHERE k.fingerprint = $1 AND a.disabled_at IS NULL",
